<Window x:Class="ContactManagerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contact Manager" Height="500" Width="400">
    <StackPanel Margin="10">
        <TextBox x:Name="NameBox" Height="30" Margin="0,0,0,5" ToolTip="Name"/>
        <TextBox x:Name="PhoneBox" Height="30" Margin="0,0,0,5" ToolTip="Phone"/>
        <TextBox x:Name="EmailBox" Height="30" Margin="0,0,0,10" ToolTip="Email"/>
        <Button Content="Add Contact" Click="AddContact_Click" Height="30" Margin="0,0,0,10"/>
        <ListBox x:Name="ContactListBox" Height="220"/>
        <Button Content="Delete Selected" Click="DeleteContact_Click" Height="30" Margin="0,10,0,0"/>
        <Button Content="Refresh" Click="Refresh_Click" Height="30" Margin="0,5,0,0"/>
    </StackPanel>
</Window>